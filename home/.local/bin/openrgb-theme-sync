#!/usr/bin/env python3
"""Apply the desktop accent to the keyboard while keeping case lighting off."""

import json
import os
from pathlib import Path
import re
import subprocess
import time


def main():
    state = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    palette = state / "quickshell/user/generated/colors.json"
    for attempt in range(5):
        try:
            color = json.loads(palette.read_text())["primary"]
            if not isinstance(color, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", color):
                raise ValueError("Invalid theme primary color")
            break
        except (OSError, ValueError, KeyError):
            if attempt == 4:
                raise
            time.sleep(0.2)

    subprocess.run([
        "/usr/bin/openrgb",
        "--device", "MSI GeForce RTX 4080 Gaming X Trio", "--mode", "Off",
        "--device", "B550M AORUS ELITE", "--mode", "Static", "--color", "000000",
        "--device", "Razer Ornata V3 Rev2", "--mode", "Static",
        "--color", color[1:], "--brightness", "15",
        "--save-profile", "ThemeSync",
    ], check=True, timeout=30)
    print(f"Keyboard theme accent: {color} at 15%; PC lighting off", flush=True)


if __name__ == "__main__":
    main()
