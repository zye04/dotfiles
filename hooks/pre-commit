#!/usr/bin/env bash
# This repo is public: refuse commits that look like they contain a secret or a personal author email.
set -euo pipefail

email=$(git config user.email || true)
case "$email" in
  *@users.noreply.github.com) ;;
  *) echo "pre-commit: user.email '$email' is not a GitHub noreply address" >&2; exit 1 ;;
esac

pattern='(sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|xox[abpr]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'
hits=$(git diff --cached -U0 --diff-filter=AM | grep -E '^\+' | grep -oE "$pattern" || true)
if [ -n "$hits" ]; then
  echo "pre-commit: staged changes look like they contain a secret:" >&2
  echo "$hits" | sed -E 's/^(.{8}).*/  \1.../' >&2
  echo "Remove it (or, if it's a false positive: git commit --no-verify)." >&2
  exit 1
fi
